      "outputs": [
        { "tag": "CONVEYOR", "type": "motor", "label": "Conveyor Motor" }
      ]
    },
    "test_vectors": [
      { "inputs": { "START": 0, "STOP": 1 }, "expected_outputs": { "CONVEYOR": 0 }, "description": "Initial state — stopped" },
      { "inputs": { "START": 1, "STOP": 1 }, "expected_outputs": { "CONVEYOR": 1 }, "description": "START pressed — running" },
      { "inputs": { "START": 0, "STOP": 1 }, "expected_outputs": { "CONVEYOR": 1 }, "description": "START released — still running (seal-in)" },
      { "inputs": { "START": 0, "STOP": 0 }, "expected_outputs": { "CONVEYOR": 0 }, "description": "STOP pressed — stopped" }
    ]
