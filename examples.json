  {
    "order_num": 4,
    "title": "Memory Logic",
    "description": "Memory logic (seal-in circuit) causes an output to stay energized after the input which initially caused it to turn on de-energizes. Pressing the normally-open pushbutton (PB1) will energize the motor contactor (M1). The motor contactor continues to be energized after the pushbutton is released. Pressing the normally-closed pushbutton (PB2) will de-energize the motor contactor.",
    "scene": "conveyor",
    "io_devices": [
      { "tag": "PB1", "type": "pushbutton-no", "label": "START (PB1)" },
      { "tag": "PB2", "type": "pushbutton-nc", "label": "STOP (PB2)" },
      { "tag": "M1",  "type": "motor",         "label": "Motor Contactor (M1)" }
    ],
    "instructions_used": ["XIC", "XIO", "OTE"],
    "program": {
      "tags": [
        { "name": "PB1", "type": "BOOL", "alias": "Start Button" },
        { "name": "PB2", "type": "BOOL", "alias": "Stop Button" },
        { "name": "M1",  "type": "BOOL", "alias": "Motor Contactor" }
      ],
      "rungs": [
        {
          "id": 0,
          "comment": "Start/Stop avec seal-in — circuit mémoire classique",
          "instructions": [
            { "type": "XIC", "tag": "PB1", "position": { "row": 0, "col": 0 } },
            { "type": "XIC", "tag": "M1",  "position": { "row": 1, "col": 0 } },
            { "type": "XIO", "tag": "PB2", "position": { "row": 0, "col": 1 } },
            { "type": "OTE", "tag": "M1",  "position": { "row": 0, "col": 2 } }
          ]
        }
      ]
    }
  },
  {
    "order_num": 5,
    "title": "Timer On-Delay (TON)",
    "description": "This program demonstrates the Timer On-Delay (TON) instruction. When the pushbutton (PB1) is pressed and held, the timer begins counting. After 5 seconds, the lamp (LAMP1) turns on. When PB1 is released, the timer resets and the lamp turns off.",
    "scene": null,
    "io_devices": [
      { "tag": "PB1",   "type": "pushbutton-no", "label": "PB1 (Start Timer)" },
      { "tag": "LAMP1", "type": "lamp",           "label": "LAMP1 (Timer Done)", "color": "green" }
    ],
    "instructions_used": ["XIC", "TON", "OTE"],
    "program": {
      "tags": [
        { "name": "PB1",      "type": "BOOL", "alias": "Start Timer" },
        { "name": "T1",       "type": "TIMER" },
        { "name": "LAMP1",    "type": "BOOL", "alias": "Timer Done Lamp" }
      ],
      "rungs": [
        {
          "id": 0,
          "comment": "Activer le timer TON quand PB1 est pressé",
          "instructions": [
            { "type": "XIC", "tag": "PB1", "position": { "row": 0, "col": 0 } },
            { "type": "TON", "tag": "T1",  "preset": 5000, "position": { "row": 0, "col": 1 } }
          ]
        },
        {
          "id": 1,
          "comment": "Allumer LAMP1 quand le timer est done",
          "instructions": [
